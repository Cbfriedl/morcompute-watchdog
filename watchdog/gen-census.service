[Unit]
Description=Rebuild the public bid-market census
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/root/morpheus/census
Environment=HISTORY_DB=/root/morpheus/census/history.db
Environment=CENSUS_FULL=/root/morpheus/census/census-full.json
EnvironmentFile=/root/morpheus/provider.env
# keep history.db current first — otherwise the "10-day window" silently
# slides backwards as the database ages
ExecStart=/usr/bin/python3 /root/morpheus/census/refresh_history.py
ExecStart=/usr/bin/python3 /root/morpheus/census/gen_census.py
# then push it to the public repo
ExecStartPost=/root/morpheus/census/publish.sh
TimeoutStartSec=3600
