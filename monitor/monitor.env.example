# Morpheus monitor config.
# Deploy to the box as /root/morpheus/monitor/monitor.env with chmod 600.
#
# NOTE: this file contains NO wallet key and NO ability to spend. The monitor
# is strictly read-only. The only sensitive value here is NTFY_TOPIC, which is
# a capability: anyone who learns it can read your alerts and post fake ones.
# Never commit the real topic to a public repo.

PROVIDER_ADDRESS=0xYOUR_PROVIDER_ADDRESS

# Deliberately a DIFFERENT endpoint than the router's ETH_NODE_ADDRESS, so a
# monitor poll can never rate-limit the node it is watching.
MONITOR_RPC=https://base.drpc.org

# ntfy: subscribe to this exact topic in the ntfy app. Use a long random
# string — public-server topics are readable by anyone who guesses them.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=CHANGE-ME-to-a-long-random-topic

# Router management API (localhost only — do not expose 8082).
ROUTER_URL=http://localhost:8082
ROUTER_AUTH=admin:REPLACE-WITH-VALUE-FROM-.cookie

CONTAINER_NAME=morpheus-router

# --- thresholds ---
# Alert when headroom (stake - limitPeriodEarned) drops below this % of stake.
HEADROOM_WARN_PCT=30
# Alert when wallet ETH falls below this (cannot pay gas -> re-stake fails).
ETH_MIN=0.005
# Set true only AFTER a bid is intentionally live; until then 0 bids is normal.
EXPECT_BIDS=false
# Re-send a still-active alert at most this often (hours).
REALERT_HOURS=6
# Consecutive RPC failures before alerting (avoids crying wolf on one flake).
RPC_FAIL_THRESHOLD=3

# Optional external dead-man's switch ping URL (healthchecks.io or similar).
# Pinged ONLY on a run that successfully read the chain.
HEARTBEAT_URL=
